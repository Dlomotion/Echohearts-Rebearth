[Unit]
Description=EchoHearts servers (web 8080 + multiplayer 7777)
After=network.target

[Service]
Type=simple
WorkingDirectory=__SERVERS_DIR__
# Web server in the foreground (systemd tracks it); multiplayer started alongside.
ExecStart=/bin/bash -c '__SERVERS_DIR__/multiplayer/echohearts-server 7777 & exec python3 __SERVERS_DIR__/web/server.py 8080 __REPO_ROOT__'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
