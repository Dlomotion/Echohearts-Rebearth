FROM python:3.12-slim
WORKDIR /site
# The web image expects the game folders next to it in the build context.
# Build from the repo/staging root so these COPY paths resolve, e.g.:
#   docker build -f echohearts-servers/Dockerfile.web .
COPY echohearts-playable ./echohearts-playable
COPY echohearts-rebirth-game ./echohearts-rebirth-game
COPY echohearts-servers/web/server.py ./server.py
EXPOSE 8080
CMD ["python3", "server.py", "8080", "/site"]
