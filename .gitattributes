# Text normalization
* text=auto
*.h text eol=lf
*.hpp text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Unreal binary assets: LFS + locking because they are not safely mergeable.
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap   filter=lfs diff=lfs merge=lfs -text lockable

# Large DCC/source binaries commonly used by the project.
*.fbx   filter=lfs diff=lfs merge=lfs -text lockable
*.blend filter=lfs diff=lfs merge=lfs -text lockable
*.psd   filter=lfs diff=lfs merge=lfs -text lockable
*.tga   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.mp4   filter=lfs diff=lfs merge=lfs -text

# PNG/JPEG files are intentionally NOT globally forced into LFS.
# Keep normal UI/reference images in Git when small. Move genuinely large source-art
# files into an approved SourceArt path and add a path-specific LFS rule when needed.
