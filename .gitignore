# Echohearts Rebearth - Local and generated file exclusions

# Unreal Engine generated output
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Log/
PackagedOutput/
BuildTemplates/

# IDE / generated project files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.userosscache
*.sln.docstates
*.opensdf
*.sdf
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb

# Local build/log artifacts
*.log
*.tmp
*.user
*.userprefs
*.swp
*.swo
*~
*.orig

# Local environment / config
.env
.env.local
config.local.json

# Node / Python cache
node_modules/
__pycache__/
*.pyc
*.pyo

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Do not ignore Build/ globally: Unreal projects may contain source-controlled build resources there.
